APP_ENV=production
APP_HOST_PORT=8080
APP_TITLE=NYC Sanitation – Collection Map
APP_SUBTITLE=See collection schedules by street and day.
APP_BROWSER_TITLE=NYC Sanitation Collection Map
APP_META_DESCRIPTION=Map NYC sanitation collection schedules by street and day.
APP_PUBLIC_URL=
APP_ROBOTS_TXT=
VITE_BASEMAP_TILEJSON_URL=https://tiles.openfreemap.org/planet
DATA_MANIFEST_PATH=/app/data/data_manifest.json
DATA_RELEASE_RETENTION=2
HEALTH_SYNC_HASH_MAX_BYTES=16777216
DATA_REFRESH_ENABLED=true
DATA_REFRESH_INTERVAL_DAYS=14
DATA_REFRESH_FAILURE_RETRY_MINUTES=30
DATA_REFRESH_ON_STARTUP=true
TILE_MIN_ZOOM=11
TILE_MAX_ZOOM=16
TILE_MAX_COMPRESSED_BYTES=1572864
TILE_MAX_UNCOMPRESSED_BYTES=6291456
MIN_LION_SOURCE_ROWS=200000
MIN_DSNY_SOURCE_ROWS=500
MIN_OUTPUT_FEATURES=100000
MAX_COUNT_DROP_PERCENT=10
